#!/usr/bin/env bash
set -Eeuo pipefail
PROGRAM=usbclone
VERSION=2.0-public-rc2
REAL_USER="${SUDO_USER:-${USER:-root}}"
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | awk -F: '{print $6}' || true)"
REAL_HOME="${REAL_HOME:-$HOME}"
CLONE_HOME="${USB_CLONE_HOME:-$REAL_HOME/USB-CLONES}"
PROFILES="$CLONE_HOME/profiles"
CONFIGFS=/sys/kernel/config
GADGET_ROOT="$CONFIGFS/usb_gadget"
say(){ printf '%s\n' "$*"; }
err(){ printf 'Error: %s\n' "$*" >&2; }
die(){ err "$*"; exit 1; }
need_root(){ if [ "${EUID:-$(id -u)}" -ne 0 ]; then exec sudo env USB_CLONE_HOME="$CLONE_HOME" "$0" "$@"; fi; }
init_dirs(){ mkdir -p "$PROFILES"; chmod 700 "$CLONE_HOME" "$PROFILES" 2>/dev/null || true; if [ "${EUID:-$(id -u)}" -eq 0 ] && [ "$REAL_USER" != root ]; then chown "$REAL_USER:$REAL_USER" "$CLONE_HOME" "$PROFILES" 2>/dev/null || true; fi; }
valid_name(){ [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }
profile_dir(){ printf '%s/%s' "$PROFILES" "$1"; }
gadget_dir(){ printf '%s/usbclone_%s' "$GADGET_ROOT" "$1"; }
read_one(){ [ -r "$1" ] && cat "$1" 2>/dev/null | tr -d '\r\n' || true; }
write_attr(){ printf '%s\n' "$2" > "$1"; }
clear_attr(){ [ -e "$1" ] || return 0; printf '\n' > "$1" 2>/dev/null || true; }
mount_configfs(){ modprobe libcomposite; modprobe usb_f_mass_storage 2>/dev/null || true; mountpoint -q "$CONFIGFS" || mount -t configfs none "$CONFIGFS"; mkdir -p "$GADGET_ROOT"; }
load_dummy(){ modinfo dummy_hcd >/dev/null 2>&1 || die 'dummy_hcd is not installed; run install.sh first'; modprobe dummy_hcd; }
available_udc(){ local requested="${1:-}" udc g; if [ -n "$requested" ]; then [ -e "/sys/class/udc/$requested" ] || die "UDC not found: $requested"; printf '%s' "$requested"; return; fi; while IFS= read -r udc; do [ -n "$udc" ] || continue; local used=0; for g in "$GADGET_ROOT"/*; do [ -d "$g" ] || continue; [ "$(read_one "$g/UDC")" = "$udc" ] && used=1; done; [ "$used" -eq 0 ] && { printf '%s' "$udc"; return; }; done < <(find /sys/class/udc -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sort -V); return 1; }
same_vidpid_present(){ lsusb -d "$1:$2" >/dev/null 2>&1; }
cmd_scan(){ lsblk -S -o NAME,TRAN,VENDOR,MODEL,REV,SERIAL,SIZE; echo; lsusb; }
cmd_show(){ local name="${1:-}" env; [ -n "$name" ] || die 'usage: usbclone show NAME'; valid_name "$name" || die 'invalid profile name'; env="$(profile_dir "$name")/profile.env"; [ -r "$env" ] || die "profile not found: $name"; cat "$env"; }
cmd_repo(){ init_dirs; printf '%s\n' "$CLONE_HOME"; }
cmd_doctor(){ local fail=0 c; for c in lsusb lsblk modinfo modprobe findmnt; do command -v "$c" >/dev/null || { echo "MISSING: $c"; fail=1; }; done; modinfo dummy_hcd >/dev/null 2>&1 || { echo 'MISSING: dummy_hcd'; fail=1; }; [ -d /sys/class/udc ] || { echo 'MISSING: /sys/class/udc'; fail=1; }; echo "USB_CLONE_HOME=$CLONE_HOME"; echo "VERSION=$VERSION"; [ "$fail" -eq 0 ]; }
cleanup_gadget(){ local g="$1" f link; [ -d "$g" ] || return 0; clear_attr "$g/UDC"; for link in "$g"/configs/*/mass_storage.*; do [ -L "$link" ] && rm -f "$link"; done; for f in "$g"/functions/mass_storage.*; do [ -d "$f" ] || continue; clear_attr "$f/lun.0/file"; rmdir "$f" 2>/dev/null || true; done; find "$g/configs" "$g/strings" -mindepth 1 -type d -depth -exec rmdir {} \; 2>/dev/null || true; rmdir "$g" 2>/dev/null || true; }
cmd_stop(){ need_root stop "$@"; local name="${1:-}"; [ -n "$name" ] || die 'usage: usbclone stop NAME'; valid_name "$name" || die 'invalid profile name'; cleanup_gadget "$(gadget_dir "$name")"; }
cmd_stop_all(){ need_root stop-all; mount_configfs; local g; for g in "$GADGET_ROOT"/usbclone_*; do [ -d "$g" ] || continue; cleanup_gadget "$g"; done; }
cmd_status(){ local g; printf '%-30s %-20s\n' PROFILE UDC; for g in "$GADGET_ROOT"/usbclone_*; do [ -d "$g" ] || continue; printf '%-30s %-20s\n' "${g##*/usbclone_}" "$(read_one "$g/UDC")"; done; }
cmd_start(){ need_root start "$@"; local name="${1:-}" requested="${2:-}" dir env img g f udc; [ -n "$name" ] || die 'usage: usbclone start NAME [dummy_udc.N]'; valid_name "$name" || die 'invalid profile name'; dir="$(profile_dir "$name")"; env="$dir/profile.env"; img="$dir/disk.img"; [ -r "$env" ] || die "profile not found: $name"; [ -f "$img" ] || die "disk.img missing: $name"; source "$env"; : "${VID:?}" "${PID:?}" "${USB_MANUFACTURER:?}" "${USB_PRODUCT:?}" "${USB_SERIAL:?}"; mount_configfs; load_dummy; same_vidpid_present "$VID" "$PID" && die "VID:PID $VID:$PID already present"; g="$(gadget_dir "$name")"; cleanup_gadget "$g"; udc="$(available_udc "$requested" || true)"; [ -n "$udc" ] || die 'no free UDC'; mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"; write_attr "$g/idVendor" "0x$VID"; write_attr "$g/idProduct" "0x$PID"; write_attr "$g/bcdUSB" "0x${BCD_USB:-0200}"; write_attr "$g/bcdDevice" "0x${BCD_DEVICE:-0100}"; write_attr "$g/strings/0x409/manufacturer" "$USB_MANUFACTURER"; write_attr "$g/strings/0x409/product" "$USB_PRODUCT"; write_attr "$g/strings/0x409/serialnumber" "$USB_SERIAL"; write_attr "$g/configs/c.1/strings/0x409/configuration" "${CONFIGURATION:-USB Mass Storage}"; write_attr "$g/configs/c.1/bmAttributes" "0x${BM_ATTRIBUTES:-80}"; write_attr "$g/configs/c.1/MaxPower" "${MAX_POWER:-250}"; f="$g/functions/mass_storage.0"; mkdir -p "$f"; write_attr "$f/lun.0/removable" "${REMOVABLE:-1}"; write_attr "$f/lun.0/ro" "${READ_ONLY:-0}"; write_attr "$f/lun.0/file" "$img"; ln -s "$f" "$g/configs/c.1/mass_storage.0"; write_attr "$g/UDC" "$udc"; say "bound: $name on $udc"; }
cmd_import(){ local archive="${1:-}" name="${2:-}" tmp source; [ -n "$archive" ] || die 'usage: usbclone import ARCHIVE.tar.gz [NAME]'; [ -f "$archive" ] || die 'archive not found'; init_dirs; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN; tar -xzf "$archive" -C "$tmp"; source="$(find "$tmp" -type f -name profile.env -printf '%h\n' | head -n1)"; [ -n "$source" ] || die 'profile.env not found in archive'; name="${name:-$(basename "$source")}"; valid_name "$name" || die 'invalid profile name'; [ ! -e "$(profile_dir "$name")" ] || die 'profile already exists'; mkdir -p "$(profile_dir "$name")"; cp -a "$source/profile.env" "$(profile_dir "$name")/"; [ ! -f "$source/disk.img" ] || cp --reflink=auto --sparse=always "$source/disk.img" "$(profile_dir "$name")/disk.img"; say "imported: $name"; }
cmd_export(){ local name="${1:-}" archive="${2:-}" dir; [ -n "$name" ] || die 'usage: usbclone export NAME [ARCHIVE.tar.gz]'; valid_name "$name" || die 'invalid profile name'; dir="$(profile_dir "$name")"; [ -r "$dir/profile.env" ] || die 'profile not found'; archive="${archive:-$PWD/$name-usbclone.tar.gz}"; tar -C "$PROFILES" -czf "$archive" "$name"; say "exported: $archive"; }
cmd_capture(){ die 'capture from a physical USB device is intentionally disabled in rc2 pending physical clean-room review; import a reviewed profile or create one from the synthetic example'; }
cmd_unmount(){ die 'unmount helper is intentionally disabled in rc2 pending physical clean-room review'; }
usage(){ cat <<'EOF'
AAG USB Clone 2.0 public RC2
Commands:
  scan
  repo
  show NAME
  status
  doctor
  start NAME [dummy_udc.N]
  stop NAME
  stop-all
  import ARCHIVE.tar.gz [NAME]
  export NAME [ARCHIVE.tar.gz]
  capture ...    (disabled until physical clean-room review)
  unmount ...    (disabled until physical clean-room review)
EOF
}
main(){ local cmd="${1:-help}"; shift || true; case "$cmd" in scan) cmd_scan "$@";; repo) cmd_repo "$@";; show) cmd_show "$@";; status) cmd_status "$@";; doctor) cmd_doctor "$@";; start) cmd_start "$@";; stop) cmd_stop "$@";; stop-all) cmd_stop_all "$@";; import) cmd_import "$@";; export) cmd_export "$@";; capture|capture-empty|capture-full) cmd_capture "$@";; unmount) cmd_unmount "$@";; -h|--help|help) usage;; --version) echo "$VERSION";; *) die "unknown command: $cmd";; esac; }
main "$@"
