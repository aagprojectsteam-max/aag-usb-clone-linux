#!/usr/bin/env bash
set -Eeuo pipefail
PROGRAM="usbclone"
VERSION="2.0-public-rc1"
REAL_USER="${SUDO_USER:-${USER:-root}}"
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | awk -F: '{print $6}' || true)"
REAL_HOME="${REAL_HOME:-$HOME}"
CLONE_HOME="${USB_CLONE_HOME:-$REAL_HOME/USB-CLONES}"
PROFILES="$CLONE_HOME/profiles"
CONFIGFS=/sys/kernel/config
GADGET_ROOT="$CONFIGFS/usb_gadget"
say(){ printf '%s\n' "$*"; }; err(){ printf 'Error: %s\n' "$*" >&2; }; die(){ err "$*"; exit 1; }
need_root(){ if [ "${EUID:-$(id -u)}" -ne 0 ]; then exec sudo env USB_CLONE_HOME="$CLONE_HOME" "$0" "$@"; fi; }
init_dirs(){ mkdir -p "$PROFILES"; chmod 700 "$CLONE_HOME" "$PROFILES" 2>/dev/null || true; if [ "${EUID:-$(id -u)}" -eq 0 ] && [ "$REAL_USER" != root ]; then chown "$REAL_USER":"$REAL_USER" "$CLONE_HOME" "$PROFILES" 2>/dev/null || true; fi; }
valid_name(){ [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]; }
profile_dir(){ printf '%s/%s' "$PROFILES" "$1"; }; gadget_name(){ printf 'usbclone_%s' "$1"; }; gadget_dir(){ printf '%s/%s' "$GADGET_ROOT" "$(gadget_name "$1")"; }
read_one(){ [ -r "$1" ] && command cat "$1" 2>/dev/null | tr -d '\r\n' || true; }
trim(){ printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }
write_attr(){ printf '%s\n' "$2" > "$1"; }
clear_attr(){ [ -e "$1" ] || return 0; printf '\n' > "$1" 2>/dev/null || true; }
mount_configfs(){ modprobe libcomposite; modprobe usb_f_mass_storage 2>/dev/null || true; mountpoint -q "$CONFIGFS" || mount -t configfs none "$CONFIGFS"; mkdir -p "$GADGET_ROOT"; }
load_dummy(){ modinfo dummy_hcd >/dev/null 2>&1 || die 'dummy_hcd is not installed; run install.sh first.'; modprobe dummy_hcd; }
available_udc(){ local requested="${1:-}" udc g used; if [ -n "$requested" ]; then [ -e "/sys/class/udc/$requested" ] || die "UDC not found: $requested"; printf '%s' "$requested"; return; fi; while IFS= read -r udc; do [ -n "$udc" ] || continue; used=0; for g in "$GADGET_ROOT"/*; do [ -d "$g" ] || continue; [ "$(read_one "$g/UDC")" = "$udc" ] && used=1; done; [ "$used" -eq 0 ] && { printf '%s' "$udc"; return; }; done < <(find /sys/class/udc -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | sort -V); return 1; }
same_vidpid_present(){ lsusb -d "$1:$2" >/dev/null 2>&1; }
find_usb_parent(){ local dev="$1" p; p="/sys$(udevadm info --query=path --name="$dev")"; while [ "$p" != / ] && [ "$p" != /sys ]; do if [ -f "$p/idVendor" ] && [ -f "$p/idProduct" ]; then printf '%s' "$p"; return 0; fi; p="$(dirname "$p")"; done; return 1; }
unmounted_for_full_copy(){ local dev="$1" line mp; while IFS= read -r line; do mp="${line#* }"; [ "$mp" = "$line" ] && mp=""; [ -z "$mp" ] || [ "$mp" = - ] || return 1; done < <(lsblk -nrpo NAME,MOUNTPOINT "$dev"); }
cmd_scan(){ lsblk -S -o NAME,TRAN,VENDOR,MODEL,REV,SERIAL,SIZE; echo; lsusb; }
cmd_unmount(){ need_root unmount "$@"; local dev="${1:-}" part; [ -n "$dev" ] || die 'usage: usbclone unmount /dev/sdX'; [ -b "$dev" ] || die "block device not found: $dev"; [ "$(lsblk -dn -o TYPE "$dev" | head -n1)" = disk ] || die 'select the whole disk, not a partition'; sync; while IFS= read -r part; do [ -n "$part" ] || continue; findmnt -rn -S "$part" >/dev/null 2>&1 && umount "$part"; done < <(lsblk -nrpo NAME,TYPE "$dev" | awk '$2 == "part" {print $1}'); findmnt -rn -S "$dev" >/dev/null 2>&1 && umount "$dev" || true; }
cmd_capture(){ need_root capture "$@"; local name="${1:-}" dev="${2:-}" mode="${3:-identity}" label="${4:-USBCLONE}"; [ -n "$name" ] && [ -n "$dev" ] || die 'usage: usbclone capture NAME /dev/sdX [identity|full] [LABEL]'; valid_name "$name" || die 'invalid profile name'; [ -b "$dev" ] || die "block device not found: $dev"; [ "$(lsblk -dn -o TYPE "$dev" | head -n1)" = disk ] || die 'select the whole disk'; [ "$(trim "$(lsblk -dn -o TRAN "$dev" | head -n1)")" = usb ] || die "$dev is not identified as USB"; [[ "$mode" = identity || "$mode" = full ]] || die 'mode must be identity or full'; [ "$mode" != full ] || unmounted_for_full_copy "$dev" || die 'unmount all source partitions before a full copy'; init_dirs; local dir usb disk_name vid pid usb_man usb_prod usb_ser usb_ver bcd_dev dev_class dev_sub dev_proto max0 speed bm maxp config scsi_vendor scsi_model scsi_rev scsi_serial removable ro size inquiry img; dir="$(profile_dir "$name")"; [ ! -e "$dir" ] || die "profile already exists: $name"; mkdir -p "$dir"; chmod 700 "$dir"; usb="$(find_usb_parent "$dev")" || die 'USB parent not found'; disk_name="$(basename "$dev")"; vid="$(read_one "$usb/idVendor")"; pid="$(read_one "$usb/idProduct")"; usb_man="$(trim "$(read_one "$usb/manufacturer")")"; usb_prod="$(trim "$(read_one "$usb/product")")"; usb_ser="$(trim "$(read_one "$usb/serial")")"; usb_ver="$(trim "$(read_one "$usb/version")")"; bcd_dev="$(read_one "$usb/bcdDevice")"; dev_class="$(read_one "$usb/bDeviceClass")"; dev_sub="$(read_one "$usb/bDeviceSubClass")"; dev_proto="$(read_one "$usb/bDeviceProtocol")"; max0="$(read_one "$usb/bMaxPacketSize0")"; speed="$(read_one "$usb/speed")"; bm="$(read_one "$usb/bmAttributes")"; maxp="$(read_one "$usb/bMaxPower" | grep -oE '[0-9]+' | head -n1 || true)"; config="$(trim "$(read_one "$usb/configuration")")"; scsi_vendor="$(trim "$(read_one "/sys/class/block/$disk_name/device/vendor")")"; scsi_model="$(trim "$(read_one "/sys/class/block/$disk_name/device/model")")"; scsi_rev="$(trim "$(read_one "/sys/class/block/$disk_name/device/rev")")"; scsi_serial="$(trim "$(read_one "/sys/class/block/$disk_name/device/serial")")"; removable="$(read_one "/sys/class/block/$disk_name/removable")"; ro="$(read_one "/sys/class/block/$disk_name/ro")"; size="$(blockdev --getsize64 "$dev")"; usb_ver="${usb_ver:-2.00}"; bcd_dev="${bcd_dev:-0100}"; dev_class="${dev_class:-00}"; dev_sub="${dev_sub:-00}"; dev_proto="${dev_proto:-00}"; maxp="${maxp:-250}"; bm="${bm:-80}"; removable="${removable:-1}"; ro="${ro:-0}"; usb_man="${usb_man:-$scsi_vendor}"; usb_prod="${usb_prod:-$scsi_model}"; usb_ser="${usb_ser:-${scsi_serial:-USBCLONE-$name}}"; config="${config:-USB Mass Storage}"; inquiry="$(printf '%-8.8s%-16.16s%-4.4s' "$scsi_vendor" "$scsi_model" "$scsi_rev")"; { printf 'NAME=%q\n' "$name"; printf 'CAPTURE_MODE=%q\n' "$mode"; printf 'VID=%q\n' "$vid"; printf 'PID=%q\n' "$pid"; printf 'USB_MANUFACTURER=%q\n' "$usb_man"; printf 'USB_PRODUCT=%q\n' "$usb_prod"; printf 'USB_SERIAL=%q\n' "$usb_ser"; printf 'USB_VERSION=%q\n' "$usb_ver"; printf 'BCD_DEVICE=%q\n' "$bcd_dev"; printf 'DEVICE_CLASS=%q\n' "$dev_class"; printf 'DEVICE_SUBCLASS=%q\n' "$dev_sub"; printf 'DEVICE_PROTOCOL=%q\n' "$dev_proto"; printf 'MAX_PACKET_0=%q\n' "$max0"; printf 'USB_SPEED=%q\n' "$speed"; printf 'BM_ATTRIBUTES=%q\n' "$bm"; printf 'MAX_POWER=%q\n' "$maxp"; printf 'CONFIGURATION=%q\n' "$config"; printf 'SCSI_VENDOR=%q\n' "$scsi_vendor"; printf 'SCSI_MODEL=%q\n' "$scsi_model"; printf 'SCSI_REV=%q\n' "$scsi_rev"; printf 'SCSI_SERIAL=%q\n' "$scsi_serial"; printf 'REMOVABLE=%q\n' "$removable"; printf 'READ_ONLY=%q\n' "$ro"; printf 'DEVICE_SIZE=%q\n' "$size"; printf 'INQUIRY_STRING=%q\n' "$inquiry"; printf 'LABEL=%q\n' "${label:0:15}"; } > "$dir/profile.env"; img="$dir/disk.img"; if [ "$mode" = full ]; then say 'Copying source disk sector-for-sector (read-only source).'; dd if="$dev" of="$img" bs=16M iflag=fullblock conv=sparse,fsync status=progress; else truncate -s "$size" "$img"; if command -v mkfs.exfat >/dev/null 2>&1 && mkfs.exfat -n "${label:0:15}" "$img" >/dev/null 2>&1; then :; else mkfs.vfat -I -F 32 -n "${label:0:11}" "$img" >/dev/null; fi; fi; chmod 600 "$dir"/* 2>/dev/null || true; chown -R "$REAL_USER":"$REAL_USER" "$dir" 2>/dev/null || true; say "profile saved: $dir"; say 'Captured profile.env may contain real device identity. Review before sharing.'; }
cleanup_gadget_dir(){ local g="$1" f link; [ -d "$g" ] || return 0; clear_attr "$g/UDC"; for f in "$g"/functions/mass_storage.*; do [ -d "$f" ] || continue; [ -e "$f/lun.0/forced_eject" ] && printf '1\n' > "$f/lun.0/forced_eject" 2>/dev/null || true; done; for link in "$g"/configs/*/mass_storage.*; do [ -L "$link" ] && rm -f "$link"; done; for f in "$g"/functions/mass_storage.*; do [ -d "$f" ] || continue; clear_attr "$f/lun.0/file"; rmdir "$f" 2>/dev/null || true; done; find "$g/configs" -type d -path '*/strings/*' -depth -exec rmdir {} \; 2>/dev/null || true; find "$g/configs" -mindepth 1 -type d -depth -exec rmdir {} \; 2>/dev/null || true; find "$g/strings" -mindepth 1 -type d -depth -exec rmdir {} \; 2>/dev/null || true; rmdir "$g" 2>/dev/null || true; }
cmd_start(){ need_root start "$@"; local name="${1:-}" requested="${2:-}" dir env img g f link udc usb_hex current; [ -n "$name" ] || die 'usage: usbclone start NAME [dummy_udc.N]'; valid_name "$name" || die 'invalid profile name'; dir="$(profile_dir "$name")"; env="$dir/profile.env"; img="$dir/disk.img"; [ -r "$env" ] || die "profile not found: $name"; [ -f "$img" ] || die "disk.img missing: $name"; source "$env"; mount_configfs; load_dummy; g="$(gadget_dir "$name")"; if [ -d "$g" ]; then current="$(read_one "$g/UDC")"; [ -z "$current" ] || { say "$name already active on $current"; return; }; cleanup_gadget_dir "$g"; fi; same_vidpid_present "$VID" "$PID" && die "VID:PID $VID:$PID already present"; udc="$(available_udc "$requested" || true)"; [ -n "$udc" ] || die 'no free UDC'; mkdir -p "$g"; usb_hex="${USB_VERSION//./}"; usb_hex="$(printf '%04s' "$usb_hex" | tr ' ' 0)"; write_attr "$g/idVendor" "0x$VID"; write_attr "$g/idProduct" "0x$PID"; write_attr "$g/bcdUSB" "0x$usb_hex"; write_attr "$g/bcdDevice" "0x$BCD_DEVICE"; write_attr "$g/bDeviceClass" "0x$DEVICE_CLASS"; write_attr "$g/bDeviceSubClass" "0x$DEVICE_SUBCLASS"; write_attr "$g/bDeviceProtocol" "0x$DEVICE_PROTOCOL"; mkdir -p "$g/strings/0x409"; write_attr "$g/strings/0x409/manufacturer" "$USB_MANUFACTURER"; write_attr "$g/strings/0x409/product" "$USB_PRODUCT"; write_attr "$g/strings/0x409/serialnumber" "$USB_SERIAL"; mkdir -p "$g/configs/c.1/strings/0x409"; write_attr "$g/configs/c.1/strings/0x409/configuration" "$CONFIGURATION"; write_attr "$g/configs/c.1/bmAttributes" "0x$BM_ATTRIBUTES"; write_attr "$g/configs/c.1/MaxPower" "$MAX_POWER"; f="$g/functions/mass_storage.0"; mkdir -p "$f"; write_attr "$f/stall" 1; write_attr "$f/lun.0/removable" "$REMOVABLE"; write_attr "$f/lun.0/ro" "$READ_ONLY"; write_attr "$f/lun.0/cdrom" 0; write_attr "$f/lun.0/nofua" 0; [ ! -e "$f/lun.0/inquiry_string" ] || write_attr "$f/lun.0/inquiry_string" "$INQUIRY_STRING"; write_attr "$f/lun.0/file" "$img"; link="$g/configs/c.1/mass_storage.0"; ln -s "$f" "$link"; write_attr "$g/UDC" "$udc"; for _ in $(seq 1 30); do same_vidpid_present "$VID" "$PID" && { say "active: $name on $udc"; return; }; sleep .25; done; cleanup_gadget_dir "$g"; die 'gadget bound but enumeration was not observed'; }
cmd_stop(){ need_root stop "$@"; local name="${1:-}" g; [ -n "$name" ] || die 'usage: usbclone stop NAME'; g="$(gadget_dir "$name")"; [